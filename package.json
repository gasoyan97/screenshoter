{
  "name": "scrinsjater",
  "version": "1.0.0",
  "description": "Quick screenshot tool for macOS with annotations and Yandex Disk upload",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "build": {
    "appId": "com.scrinsjater.app",
    "productName": "Scrinsjater",
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "assets/icon.png",
      "entitlements": "build/entitlements.mac.plist"
    }
  }
}
