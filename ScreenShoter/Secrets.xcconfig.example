// Yandex OAuth credentials for local development
// 1. Copy this file to Secrets.xcconfig: cp Secrets.xcconfig.example Secrets.xcconfig
// 2. Fill in your Client ID and Client Secret from https://oauth.yandex.ru
// 3. Secrets.xcconfig is in .gitignore — never commit it
// For CI builds: GitHub Secrets YANDEX_CLIENT_ID and YANDEX_CLIENT_SECRET are used

YANDEX_CLIENT_ID = 
YANDEX_CLIENT_SECRET = 
